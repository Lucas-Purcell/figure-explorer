{
  "name": "figure-explorer",
  "displayName": "Figure Explorer",
  "description": "Browse figures generated in Jupyter notebooks.",
  "version": "0.1.12",
  "publisher": "LPurcell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lucas-Purcell/figure-explorer"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Notebooks",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:figureExplorer.figures",
    "onCommand:figure-explorer.scanNotebook",
    "onNotebook:jupyter-notebook"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "figure-explorer.scanNotebook",
        "title": "Figure Explorer: Scan Notebook"
      },
      {
        "command": "figure-explorer.openFigure",
        "title": "Figure Explorer: Open Figure"
      },
      {
        "command": "figure-explorer.openNotebookGallery",
        "title": "Figure Explorer: Open Notebook Gallery"
      },
      {
        "command": "figure-explorer.openFigureGallery",
        "title": "Figure Explorer: Open Figure in Gallery"
      },
      {
        "command": "figure-explorer.revealFigureCell",
        "title": "Reveal Cell"
      },
      {
        "command": "figure-explorer.saveFigureAsPng",
        "title": "Save PNG"
      },
      {
        "command": "figure-explorer.exportFigureAsPdf",
        "title": "Export PDF"
      },
      {
        "command": "figure-explorer.openGalleryInEditor",
        "title": "Figure Explorer: Open Gallery in Editor"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "figure-explorer.openFigureGallery",
          "when": "false"
        },
        {
          "command": "figure-explorer.openFigure",
          "when": "false"
        },
        {
          "command": "figure-explorer.openNotebookGallery",
          "when": "false"
        },
        {
          "command": "figure-explorer.revealFigureCell",
          "when": "false"
        },
        {
          "command": "figure-explorer.saveFigureAsPng",
          "when": "false"
        },
        {
          "command": "figure-explorer.exportFigureAsPdf",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "figure-explorer.revealFigureCell",
          "when": "view == figureExplorer.figures && viewItem == figureExplorer.figure",
          "group": "navigation@1"
        },
        {
          "command": "figure-explorer.saveFigureAsPng",
          "when": "view == figureExplorer.figures && viewItem == figureExplorer.figure",
          "group": "navigation@2"
        },
        {
          "command": "figure-explorer.exportFigureAsPdf",
          "when": "view == figureExplorer.figures && viewItem == figureExplorer.figure",
          "group": "navigation@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "figureExplorer",
          "title": "Figure Explorer",
          "icon": "resources/Icon.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "figureExplorer.figures",
          "name": "Figures",
          "icon": "resources/Icon.svg"
        }
      ],
      "figureExplorer": [
        {
          "id": "figureExplorer.gallery",
          "name": "Gallery",
          "type": "webview",
          "icon": "resources/Icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.74.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
